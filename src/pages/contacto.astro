---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SCHEMA_IDS } from '../data/site';
import { DISCIPLINES } from '../data/disciplines';
import { LOCATIONS } from '../data/locations';

// El formulario tiene dos modos de envío y siempre se muestra:
//
//  1. Con PUBLIC_FORMSPREE_ID definida (Vercel), envía por Formspree en segundo
//     plano y el visitante no sale de la página. Es el modo bueno y el objetivo.
//  2. Sin esa variable, el mismo formulario compone un correo con los datos ya
//     ordenados y lo abre en el cliente de correo del visitante. Funciona desde
//     el primer día, sin cuentas de terceros y sin que ningún intermediario
//     trate datos personales — a cambio de un clic más y de perder a quien no
//     tenga cliente de correo configurado.
//
// El modo 2 es un puente, no un destino: en cuanto exista la cuenta de
// Formspree, definir la variable y el formulario pasa solo al modo 1.
const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID as string | undefined;
const envioDirecto = Boolean(FORMSPREE_ID);

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${SITE.url}/contacto/`,
  name: 'Contacto | Artes Marciales Garraf',
  description:
    'Cuéntanos qué disciplina te interesa y en qué municipio del Garraf, y te orientamos sin coste sobre cómo empezar.',
  url: `${SITE.url}/contacto/`,
  inLanguage: 'es',
  isPartOf: { '@id': SCHEMA_IDS.website },
  publisher: { '@id': SCHEMA_IDS.organization },
  dateModified: SITE.ultimaRevision,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Contacto', item: `${SITE.url}/contacto/` },
  ],
};

const inputClass =
  'w-full bg-brand-gray border border-brand-border rounded-lg px-4 py-3 text-white text-sm placeholder-brand-muted focus:outline-none focus:border-brand-red transition-colors';
---

<Layout
  title="Contacto | Orientación Gratuita · Artes Marciales Garraf"
  description="¿Quieres empezar a entrenar artes marciales en el Garraf? Cuéntanos qué buscas y te orientamos sin coste. Formulario de contacto y email."
  canonical="/contacto/"
  schema={[contactSchema, breadcrumbSchema]}
>
  <Header />

  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="inline-block bg-brand-red/15 text-brand-red text-xs font-semibold px-3 py-1 rounded-full mb-4 uppercase tracking-wider border border-brand-red/30">
          Orientación gratuita
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-white mb-4">Cuéntanos qué buscas</h1>
        <p class="text-brand-muted max-w-lg mx-auto">
          Dinos qué disciplina te interesa, en qué municipio y para quién, y te orientamos sin coste
          sobre cómo empezar. Sin compromiso y sin spam.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <form
            id="contact-form"
            class="space-y-5"
            data-modo={envioDirecto ? 'formspree' : 'correo'}
            data-destino={SITE.email}
            action={envioDirecto ? `https://formspree.io/f/${FORMSPREE_ID}` : undefined}
            method="POST"
            novalidate={false}
          >
            <div>
              <label for="nombre" class="block text-sm font-medium text-white mb-1.5">Nombre *</label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name"
                class={inputClass} placeholder="Tu nombre" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-white mb-1.5">Email *</label>
              <input type="email" id="email" name="email" required autocomplete="email"
                class={inputClass} placeholder="tu@email.com" />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-medium text-white mb-1.5">Teléfono (opcional)</label>
              <input type="tel" id="telefono" name="telefono" autocomplete="tel"
                class={inputClass} placeholder="+34 600 000 000" />
            </div>
            <div>
              <label for="disciplina" class="block text-sm font-medium text-white mb-1.5">Disciplina de interés</label>
              <select id="disciplina" name="disciplina" class={inputClass}>
                <option value="">Selecciona una disciplina</option>
                {DISCIPLINES.map(d => <option value={d.nameEs}>{d.nameEs}</option>)}
                <option value="No lo tengo claro">No lo tengo claro</option>
              </select>
            </div>
            <div>
              <label for="municipio" class="block text-sm font-medium text-white mb-1.5">Municipio</label>
              <select id="municipio" name="municipio" class={inputClass}>
                <option value="">Selecciona tu municipio</option>
                {LOCATIONS.map(l => <option value={l.name}>{l.name}</option>)}
                <option value="Otro">Otro</option>
              </select>
            </div>
            <div>
              <label for="mensaje" class="block text-sm font-medium text-white mb-1.5">Mensaje (opcional)</label>
              <textarea id="mensaje" name="mensaje" rows="3" class={`${inputClass} resize-none`}
                placeholder="Cuéntanos tu objetivo, tu edad o la de tu hijo/a, y cualquier duda que tengas"></textarea>
            </div>

            <!-- Consentimiento expreso (RGPD art. 6.1.a): casilla sin marcar por
                 defecto. Aceptar no puede ser un efecto secundario de enviar. -->
            <div class="flex gap-3 items-start">
              <input type="checkbox" id="consentimiento" name="consentimiento" required value="si"
                class="mt-1 w-4 h-4 shrink-0 accent-brand-red" />
              <label for="consentimiento" class="text-xs text-brand-muted leading-relaxed">
                He leído y acepto la <a href="/politica-privacidad/" class="text-brand-red hover:underline">política de privacidad</a>.
                Mis datos se usan solo para responder a esta consulta y no se ceden a ningún centro sin
                mi permiso expreso.
              </label>
            </div>

            <!-- Trampa antispam: los bots rellenan todos los campos, las personas
                 no ven este. Si llega con contenido, el envío se descarta. -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <input type="hidden" name="_subject" value="Nueva solicitud de orientación - Artes Marciales Garraf" />

            <button type="submit" id="contact-submit"
              class="w-full bg-brand-red hover:bg-red-700 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold py-4 rounded-lg transition-colors text-lg">
              Pedir orientación gratuita →
            </button>

            {!envioDirecto && (
              <p class="text-xs text-brand-muted text-center">
                Al enviar se abrirá tu programa de correo con el mensaje ya redactado, para que solo
                tengas que darle a enviar.
              </p>
            )}
          </form>

          <!-- Estados de respuesta: se muestran sin recargar la página -->
          <div id="contact-ok" hidden
            class="bg-brand-gray border border-brand-red/40 rounded-xl p-6 text-center space-y-3">
            <h2 class="text-lg font-bold text-white">Mensaje enviado</h2>
            <p class="text-sm text-brand-muted leading-relaxed">
              Gracias por escribirnos. Te respondemos al correo que nos has dejado, normalmente en
              menos de 48 horas.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed">
              Mientras tanto, échale un ojo al
              <a href="/centros/" class="text-brand-red hover:text-red-400">directorio de centros del Garraf</a>.
            </p>
          </div>

          <div id="contact-correo" hidden
            class="bg-brand-gray border border-brand-border rounded-xl p-6 text-center space-y-3">
            <h2 class="text-lg font-bold text-white">Revisa tu programa de correo</h2>
            <p class="text-sm text-brand-muted leading-relaxed">
              Hemos abierto un mensaje con tus datos ya redactados. Solo tienes que darle a enviar.
            </p>
            <p class="text-sm text-brand-muted leading-relaxed">
              ¿No se ha abierto nada? Escríbenos directamente a
              <a href={`mailto:${SITE.email}`} class="text-brand-red hover:text-red-400">{SITE.email}</a>.
            </p>
          </div>

          <div id="contact-error" hidden
            class="bg-brand-gray border border-brand-border rounded-xl p-6 text-center space-y-3">
            <h2 class="text-lg font-bold text-white">No hemos podido enviarlo</h2>
            <p class="text-sm text-brand-muted leading-relaxed">
              Ha fallado algo por nuestro lado. Escríbenos directamente a
              <a href={`mailto:${SITE.email}`} class="text-brand-red hover:text-red-400">{SITE.email}</a>
              y lo resolvemos igual.
            </p>
          </div>
        </div>

        <!-- Contact info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-lg font-bold text-white mb-4">O escríbenos por email</h2>
            <a href={`mailto:${SITE.email}`}
              class="flex items-center gap-4 bg-brand-gray border border-brand-border rounded-xl p-4 hover:border-brand-red/40 transition-colors group">
              <div class="w-10 h-10 rounded-lg bg-brand-red/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs text-brand-muted">Email</p>
                <p class="font-semibold text-white group-hover:text-brand-red transition-colors">{SITE.email}</p>
              </div>
            </a>
          </div>

          <div>
            <h2 class="text-lg font-bold text-white mb-4">Qué puedes esperar</h2>
            <div class="bg-brand-gray border border-brand-border rounded-xl p-6 space-y-3">
              {[
                'Te respondemos por email con orientación concreta para tu caso.',
                'Te explicamos qué disciplina encaja con tu objetivo y qué valorar al elegir centro en tu municipio.',
                'No compartimos tus datos con nadie sin tu consentimiento expreso.',
                'No gestionamos altas ni cobramos comisión: la matrícula la haces tú, directamente con el centro.',
              ].map(item => (
                <p class="flex gap-2 text-sm text-brand-muted">
                  <span class="text-brand-red shrink-0">✓</span>
                  {item}
                </p>
              ))}
            </div>
          </div>

          <div>
            <h2 class="text-lg font-bold text-white mb-4">Sobre esta web</h2>
            <div class="bg-brand-gray border border-brand-border rounded-xl p-4">
              <p class="text-sm text-brand-muted leading-relaxed">
                Artes Marciales Garraf es una guía independiente: no somos un gimnasio ni una academia. Nuestro objetivo es ayudarte a empezar a entrenar con información honesta sobre la comarca. <a href="/sobre-nosotros/" class="text-brand-red hover:underline">Más sobre el proyecto →</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const boton = document.getElementById('contact-submit') as HTMLButtonElement;
    const panelOk = document.getElementById('contact-ok')!;
    const panelCorreo = document.getElementById('contact-correo')!;
    const panelError = document.getElementById('contact-error')!;

    const mostrar = (panel: HTMLElement) => {
      form.hidden = true;
      panel.hidden = false;
      panel.scrollIntoView({ block: 'center' });
    };

    /** Redacta el correo con los campos ya ordenados, para no obligar a nadie a
     *  escribir de cero cuando el envío va por el cliente de correo. */
    const componerCorreo = (datos: FormData) => {
      const campo = (clave: string) => String(datos.get(clave) ?? '').trim();
      const lineas = [
        `Nombre: ${campo('nombre')}`,
        `Email: ${campo('email')}`,
        campo('telefono') ? `Teléfono: ${campo('telefono')}` : null,
        campo('disciplina') ? `Disciplina de interés: ${campo('disciplina')}` : null,
        campo('municipio') ? `Municipio: ${campo('municipio')}` : null,
        '',
        campo('mensaje') || '(sin mensaje adicional)',
      ].filter(l => l !== null);

      const destino = form.dataset.destino!;
      const asunto = 'Solicitud de orientación — Artes Marciales Garraf';
      return `mailto:${destino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(lineas.join('\n'))}`;
    };

    form.addEventListener('submit', async event => {
      // La validación nativa del navegador ya ha pasado en este punto: el campo
      // obligatorio de consentimiento incluido.
      event.preventDefault();

      const datos = new FormData(form);

      // Honeypot: si viene relleno es un bot. Se finge éxito para no darle pistas.
      if (String(datos.get('_gotcha') ?? '').trim() !== '') {
        mostrar(panelOk);
        return;
      }

      if (form.dataset.modo === 'correo') {
        window.location.href = componerCorreo(datos);
        mostrar(panelCorreo);
        return;
      }

      boton.disabled = true;
      const textoOriginal = boton.textContent;
      boton.textContent = 'Enviando…';

      try {
        const respuesta = await fetch(form.action, {
          method: 'POST',
          body: datos,
          headers: { Accept: 'application/json' },
        });
        if (!respuesta.ok) throw new Error(`Formspree respondió ${respuesta.status}`);
        mostrar(panelOk);
      } catch {
        // Sin conexión o error del proveedor: se ofrece el correo directo en
        // lugar de perder el mensaje.
        mostrar(panelError);
      } finally {
        boton.disabled = false;
        boton.textContent = textoOriginal;
      }
    });
  }
</script>
